# Database
DATABASE_URL="postgresql://studio:studio@localhost:5432/social_studio?schema=public"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Discord Webhook Adapter
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Application
NODE_ENV="development"
PORT="3000"
API_PREFIX="/api/v1"

# JWT Auth
JWT_SECRET="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# Logging
LOG_LEVEL="debug"