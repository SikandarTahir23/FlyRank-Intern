generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  DISCORD
  TWITTER
  LINKEDIN
  INSTAGRAM
}

enum VariantStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum UserRole {
  VIEWER
  EDITOR
  APPROVER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole @default(VIEWER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts    Post[]    @relation("PostAuthor")
  reviews  Review[]  @relation("ReviewApprover")
  variants Variant[] @relation("VariantAuthor")
}

model Post {
  id             String   @id @default(cuid())
  title          String
  sourceUrl      String?  @unique
  sourceMarkdown String?  @db.Text
  description    String?
  authorId       String
  author         User     @relation("PostAuthor", fields: [authorId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants Variant[]
  slots    TimeSlot[]

  @@index([authorId])
  @@index([sourceUrl])
}

model Variant {
  id             String        @id @default(cuid())
  postId         String
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation("VariantAuthor", fields: [authorId], references: [id])
  platform       Platform
  content        String        @db.Text
  mediaUrls      String[]
  metadata       Json?
  status         VariantStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  rejectedReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attempts PublishAttempt[]
  reviews  Review[]
  slots    TimeSlot[]       @relation("VariantSlots")

  @@index([postId])
  @@index([authorId])
  @@index([status])
  @@index([platform])
}

model TimeSlot {
  id             String   @id @default(cuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        Variant? @relation("VariantSlots", fields: [variantId], references: [id], onDelete: SetNull)
  platform       Platform
  scheduledAt    DateTime
  timezone       String   @default("UTC")
  isRecurring    Boolean  @default(false)
  recurrenceRule String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([postId])
  @@index([variantId])
  @@index([scheduledAt])
  @@index([platform])
}

model Review {
  id         String   @id @default(cuid())
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  approverId String
  approver   User     @relation("ReviewApprover", fields: [approverId], references: [id])
  action     String
  comment    String?
  createdAt  DateTime @default(now())

  @@index([variantId])
  @@index([approverId])
}

model PublishAttempt {
  id            String   @id @default(cuid())
  variantId     String
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  platform      Platform
  externalId    String?
  success       Boolean
  error         String?
  attemptNumber Int      @default(1)
  rawResponse   Json?
  createdAt     DateTime @default(now())

  @@index([variantId])
  @@index([platform])
  @@index([success])
}

model ConstraintProfile {
  id          String   @id @default(cuid())
  platform    Platform @unique
  maxLength   Int
  maxHashtags Int
  toneRules   Json
  mediaLimits Json
  embedLimits Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
