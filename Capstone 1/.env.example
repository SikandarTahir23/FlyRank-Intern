# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capstone?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Mailpit (Email Testing)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
MAILPIT_HTTP_PORT=8025
MAILPIT_FROM=noreply@widget.local

# Submission Limits
SUBMISSION_MAX_BYTES=51200

# Rate Limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=30000

# Geo Enrichment
GEO_PROVIDER_A_URL=http://ip-api.com/json/
GEO_PROVIDER_B_URL=https://ipapi.co/json/
GEO_TIMEOUT_MS=2000
GEO_CIRCUIT_BREAKER_THRESHOLD=3
GEO_CIRCUIT_BREAKER_RESET_MS=60000

# Mock toggles for deterministic testing
MOCK_GEO_FAILURE_A=false
MOCK_GEO_FAILURE_ALL=false

# Widget Cache
WIDGET_CONFIG_CACHE_MAX_AGE=60
WIDGET_JS_CACHE_MAX_AGE=31536000