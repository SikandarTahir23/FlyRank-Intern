# Template for local configuration. Copy this file to ".env" and fill in
# real values:  cp .env.example .env
#
# NOTE ON HOSTNAMES:
# - Inside Docker Compose the API reaches the database through the Compose
#   network, where the db container is reachable under the service name
#   "db" (NOT localhost - inside a container, localhost means the container
#   itself, not its neighbor).
# - If you ever run the API directly on your host machine against a
#   Dockerized database, publish port 5432 and use "localhost" instead.

NODE_ENV=development
PORT=3000

POSTGRES_USER=todo_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=todos

DATABASE_URL=postgres://todo_user:your_password_here@db:5432/todos
