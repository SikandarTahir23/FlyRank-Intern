# Copy to .env and fill in real values:  cp .env.example .env
# Inside Docker Compose, use the service name "db" as hostname (not localhost)

NODE_ENV=development
PORT=3000

POSTGRES_USER=todo_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=todos

DATABASE_URL=postgres://todo_user:your_password_here@db:5432/todos
